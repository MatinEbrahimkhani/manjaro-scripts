#!/bin/bash

# Update the package database
sudo pacman -Syu

# Remove Google Chrome if it is already installed
sudo pacman -R google-chrome --noconfirm

# Clean up any remaining packages
sudo pacman -Rns $(pacman -Qdtq) --noconfirm

# Install Google Chrome from AUR
yay -S google-chrome --noconfirm

# Clean up
yay -Sc --noconfirm

echo "Google Chrome has been reinstalled successfully."

